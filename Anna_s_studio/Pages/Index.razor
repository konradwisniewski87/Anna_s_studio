@page "/"
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject I18nService I18n
@implements IDisposable

<div style="max-width: 900px; margin: 0 auto;">
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="4" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="5" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <a href="/services" style="display: block; text-decoration: none; color: inherit;">
                    <img src="images/KobidoUpFace.png" class="d-block w-100" alt="@I18n.T("MasterKobidoUp")">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@I18n.T("MasterKobidoUp")</h5>
                    </div>
                </a>
            </div>
            <div class="carousel-item">
                <a href="/services" style="display: block; text-decoration: none; color: inherit;">
                    <img src="images/KobidoUpBody.png" class="d-block w-100" alt="@I18n.T("KobidoBody")">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@I18n.T("KobidoBody")</h5>
                    </div>
                </a>
            </div>
            <div class="carousel-item">
                <a href="/services" style="display: block; text-decoration: none; color: inherit;">
                    <img src="images/TransBuccal.png" class="d-block w-100" alt="@I18n.T("TransBuccal")">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@I18n.T("TransBuccal")</h5>
                    </div>
                </a>
            </div>
            <div class="carousel-item">
                <a href="/services" style="display: block; text-decoration: none; color: inherit;">
                    <img src="images/FaceTaping.png" class="d-block w-100" alt="@I18n.T("AestheticKinesiologyTaping")">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@I18n.T("AestheticKinesiologyTaping")</h5>
                    </div>
                </a>
            </div>
            <div class="carousel-item">
                <a href="/services" style="display: block; text-decoration: none; color: inherit;">
                    <img src="images/AcupunctureFace.png" class="d-block w-100" alt="@I18n.T("FacialAcupuncture")">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@I18n.T("FacialAcupuncture")</h5>
                    </div>
                </a>
            </div>
            <div class="carousel-item">
                <a href="/services" style="display: block; text-decoration: none; color: inherit;">
                    <img src="images/DeepTissueMassage.png" class="d-block w-100" alt="@I18n.T("DeepTissueMassage")">
                    <div class="carousel-caption d-none d-md-block">
                        <h5>@I18n.T("DeepTissueMassage")</h5>
                    </div>
                </a>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    <div class="mt-4 text-center">
        <p class="description-fancy">@CurrentSlideDescription</p>
    </div>
</div>
<hr />
<div style="max-width: 900px; margin: 0 auto;">
    <div class="mt-5">
        <p class="mt-3 description-index first-letter">@I18n.T("AboutMe")</p>

        <p class="mt-3 description-index description-indent">
            @I18n.T("AboutMeDesc_Paragraph1")
        </p>
        <p class="description-index description-indent">
            @I18n.T("AboutMeDesc_Paragraph2")
        </p>

        <b class="description-index" style="display:block; margin: 2rem 0 1rem 0;">
            @I18n.T("AboutMeDesc_SpecializeTitle")
        </b>

        <ul class="description-index description-indent" style="list-style: none; padding-left: 0;">

            <li class="premium-check">@I18n.T("AboutMeDesc_Specialize1")</li>
            <li class="premium-check">
                @I18n.T("AboutMeDesc_Specialize2")
                <ul style="margin-top: 0.5em; margin-bottom: 0.5em;">
                    <li>@I18n.T("AboutMeDesc_Specialize2a")</li>
                    <li>@I18n.T("AboutMeDesc_Specialize2b")</li>
                    <li>@I18n.T("AboutMeDesc_Specialize2c")</li>
                </ul>
            </li>
            <li class="premium-check">@I18n.T("AboutMeDesc_Specialize3")</li>
            <li class="premium-check">@I18n.T("AboutMeDesc_Specialize4")</li>
            <li class="premium-check">@I18n.T("AboutMeDesc_Specialize5")</li>
        </ul>

        <p class="description-index description-indent">
            @I18n.T("AboutMeDesc_Paragraph3")
        </p>
        <p class="description-index description-indent">
            @I18n.T("AboutMeDesc_Paragraph4")
        </p>
        <p class="description-index description-indent">
            @I18n.T("AboutMeDesc_Paragraph5")
        </p>
    </div>
</div>



@code {
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;
    private string CurrentSlideDescription = "";
    private string[] SlideTranslationKeys = new[]
    {
        "MasterKobidoUpDescription",
        "KobidoBodyDescription",
        "TransBuccalDescription",
        "AestheticKinesiologyTapingDescription",
        "FacialAcupunctureDescription",
        "DeepTissueMassageDescription"
    };

    [JSInvokable]
    public void OnCarouselSlideChanged(int index)
    {
        if (index >= 0 && index < SlideTranslationKeys.Length)
        {
            CurrentSlideDescription = I18n.T(SlideTranslationKeys[index]);
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            OnCarouselSlideChanged(0);
            await JsRuntime.InvokeVoidAsync("initCarouselDescription", DotNetObjectReference.Create(this));
        }
    }

    protected override void OnInitialized()
    {
        I18n.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        I18n.OnChange -= StateHasChanged;
    }
}
